# Тестовое окружение на Render. Файл хранится в репозитории и подключается автоматически,
# когда приложение запущено на Render (там есть переменная RENDER). Локально он не читается.
#
# ВНИМАНИЕ: здесь пароль админки открытым текстом. Это допустимо только для теста и только если
# репозиторий приватный. Перед настоящим запуском задайте ADMIN_PASSWORD и SECRET_KEY в панели Render
# (Environment) — значения из панели важнее этого файла — и уберите их отсюда.
#
# DATABASE_URL сюда не пишем: его задаёт Render (Internal Database URL базы).

# Сайт закрыт от поисковиков, пока работает на *.onrender.com
ALLOW_INDEXING=false
# Демо-товары при первом запуске в пустую базу
SEED_DEMO=true
DEBUG=false

# Временные данные магазина
SITE_NAME=Дом металла
CITY=Москва
CITY_PREPOSITIONAL=Москве
PHONE=+7 (495) 000-00-00
EMAIL=info@example.ru
WORK_HOURS=Пн–Сб 9:00–19:00, Вс 10:00–15:00
ADDRESS=Москва, склад (адрес уточняется)
WHATSAPP=
TELEGRAM=
# Ещё телефоны и почта через запятую — в списке контактов (стрелка у телефона в шапке) и на /contacts/
EXTRA_PHONES=
EXTRA_EMAILS=
# MAX: ссылка из приложения целиком (профиль → «Поделиться»): https://max.ru/u/… или https://max.ru/@бот
MAX_URL=

# Яндекс Карта на /contacts/: координаты склада. Сейчас временная точка (промзона на юго-востоке Москвы) — заменить на настоящий склад.
MAP_LAT=55.7128
MAP_LON=37.7556
MAP_ZOOM=16

# Калькулятор
CUT_PRICE_KOP=5000
TON_PRICE_FROM_KG=1000
DELIVERY_MAX_KM=200

# Админка /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=metal2026
SECRET_KEY=KmZR3-vQVf4YRsuKMePfuFHB9NONWb-p573gXDTWjruA4zMhmMJ-eJS20Od4EtWh
