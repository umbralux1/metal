POSTGRES_DB=metal
POSTGRES_USER=metal
POSTGRES_PASSWORD=metal
POSTGRES_PORT=5433

# Строка подключения для приложения (SQLAlchemy async + psycopg 3)
DATABASE_URL=postgresql+psycopg://metal:metal@localhost:5433/metal
TEST_DATABASE_URL=postgresql+psycopg://metal:metal@localhost:5433/metal_test

DEBUG=true
SITE_URL=http://localhost:8000
# false — сайт закрыт от поисковиков (тестовые копии)
ALLOW_INDEXING=true
SITE_NAME=Металлобаза
CITY=Москва
CITY_PREPOSITIONAL=Москве
PHONE=+7 (495) 000-00-00
EMAIL=info@example.ru
WORK_HOURS=Пн–Сб 9:00–19:00, Вс 10:00–15:00
# Адрес склада и мессенджеры: пусто — блок не показывается
ADDRESS=
WHATSAPP=
TELEGRAM=

# Калькулятор: цена реза в копейках и с какого веса цена за тонну
CUT_PRICE_KOP=5000
TON_PRICE_FROM_KG=1000
