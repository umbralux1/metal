POSTGRES_DB=metal
POSTGRES_USER=metal
POSTGRES_PASSWORD=metal
POSTGRES_PORT=5433

# Строка подключения для приложения (SQLAlchemy async + psycopg 3)
DATABASE_URL=postgresql+psycopg://metal:metal@localhost:5433/metal
TEST_DATABASE_URL=postgresql+psycopg://metal:metal@localhost:5433/metal_test

DEBUG=true
SITE_URL=http://localhost:8000
# false — сайт закрыт от поисковиков (тестовые копии)
ALLOW_INDEXING=true
SITE_NAME=Дом металла
# Подпись под названием в шапке; пусто — «Металлопрокат в <город>»
SITE_TAGLINE=
CITY=Москва
CITY_PREPOSITIONAL=Москве
PHONE=+7 (495) 000-00-00
EMAIL=info@example.ru
# Из этой строки собираются часы в разметке для поисковиков («открыто до 19:00» в выдаче).
# Формат: «Пн–Пт 9:00–18:00, Сб 10:00–15:00», «Ежедневно 8:00–20:00». Выходные можно не писать.
WORK_HOURS=Пн–Сб 9:00–19:00, Вс 10:00–15:00
# Адрес склада и мессенджеры: пусто — блок не показывается
ADDRESS=Москва, склад (адрес уточняется)
# Номер WhatsApp цифрами (79160000000) и имя в Telegram без @. Не ставьте выдуманные — кнопка поведёт к чужому человеку.
WHATSAPP=
TELEGRAM=
# Ещё телефоны и почта через запятую — в списке контактов (стрелка у телефона в шапке) и на /contacts/
EXTRA_PHONES=
EXTRA_EMAILS=
# MAX: ссылка из приложения целиком (профиль → «Поделиться»): https://max.ru/u/… или https://max.ru/@бот
MAX_URL=

# Яндекс Карта на /contacts/: координаты склада (Яндекс Карты → клик по точке). Пусто — карта города без метки.
MAP_LAT=
MAP_LON=
MAP_ZOOM=16

# Калькулятор: цена реза в копейках и с какого веса цена за тонну
CUT_PRICE_KOP=5000
TON_PRICE_FROM_KG=1000

# Доставка: дальше этого расстояния, км, цену не считаем — «стоимость уточнит менеджер»
DELIVERY_MAX_KM=200

# Часовой пояс сайта: в нём админка показывает время заявок и редиректов
TIMEZONE=Europe/Moscow

# Админка /admin. Пустой пароль — админка выключена.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local
# Ключ подписи сессий админки (любая длинная случайная строка). Пусто — новый при каждом запуске.
SECRET_KEY=dev-secret-change-me

# Демо-каталог: при запуске python main.py добавить недостающие разделы и товары (существующее не меняется)
SEED_DEMO=true
